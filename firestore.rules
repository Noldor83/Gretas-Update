rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'papa@gretas-update.app'; }
    function member() { return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)); }

    // Klassen-Code: niemand kann ihn lesen, nur Papa kann ihn setzen
    match /config/secret {
      allow read: if false;
      allow write: if isAdmin();
    }
    // Profil (Name) – Anlegen nur mit richtigem Klassen-Code
    match /profiles/{uid} {
      allow read: if member();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && (isAdmin() || request.resource.data.code == get(/databases/$(database)/documents/config/secret).data.code);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Vokabeln: lesen nur angemeldete Mitglieder, ändern nur Papa
    match /vocab/{lang} {
      allow read: if member();
      allow write: if isAdmin();
    }
    // Lernstand: jede Person nur ihren eigenen
    match /progress/{uid} {
      allow read, write: if member() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    // Bestenlisten (lat / en)
    match /scores/{lang}/players/{uid} {
      allow read: if member();
      allow write: if member() && request.auth.uid == uid
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 100000;
      allow delete: if isAdmin();
    }
  }
}
